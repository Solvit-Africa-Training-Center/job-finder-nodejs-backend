<p>Hello <span class="highlight">
        <%= name %>
    </span>,</p>
<p>You have received a new message from <span class="highlight">
        <%= senderName %>
    </span>:</p>
<div style="background: #f0f0f0; padding: 15px; border-radius: 5px; margin: 20px 0;">
    <i>"<%= messagePreview %>"</i>
</div>
<a href="<%= messageUrl %>" class="button">View Message</a>
<p>Best regards,<br>The Job Finder Team</p>