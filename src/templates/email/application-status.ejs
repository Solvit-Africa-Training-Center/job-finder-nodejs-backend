<p>Hello <span class="highlight">
        <%= name %>
    </span>,</p>
<p>The status of your application for <span class="highlight">
        <%= jobTitle %>
    </span> at <span class="highlight">
        <%= companyName %>
    </span> has been updated to:</p>
<div style="text-align: center; margin: 30px 0;">
    <span
        style="font-size: 24px; font-weight: bold; padding: 10px 20px; background: #e3f2fd; color: #0d47a1; border-radius: 50px;">
        <%= status %>
    </span>
</div>
<a href="<%= applicationUrl %>" class="button">View Application Details</a>
<p>Best regards,<br>The Job Finder Team</p>