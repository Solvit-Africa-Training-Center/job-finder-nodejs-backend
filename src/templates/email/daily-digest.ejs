<p>Hello <span class="highlight">
        <%= name %>
    </span>,</p>
<p>Here's a summary of what you missed today:</p>

<% notifications.forEach(function(note) { %>
    <div style="border-bottom: 1px solid #eee; padding: 15px 0;">
        <h4 style="margin: 0; color: #1a237e;">
            <%= note.title %>
        </h4>
        <p style="margin: 5px 0; color: #555;">
            <%= note.message %>
        </p>
        <small style="color: #999;">
            <%= new Date(note.createdAt).toLocaleTimeString() %>
        </small>
    </div>
    <% }); %>

        <div style="text-align: center; margin-top: 30px;">
            <a href="<%= dashboardUrl %>" class="button">View All Notifications</a>
        </div>

        <p>Best regards,<br>The Job Finder Team</p>