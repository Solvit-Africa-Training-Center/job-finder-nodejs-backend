<p>Hello <span class="highlight">
        <%= name %>
    </span>,</p>
<p>We found a new job matching your profile:</p>
<div style="border: 1px solid #ddd; padding: 20px; border-radius: 8px; margin: 20px 0;">
    <h3 style="margin-top: 0; color: #1a237e;">
        <%= jobTitle %>
    </h3>
    <p><strong>Company:</strong>
        <%= companyName %>
    </p>
    <p><strong>Location:</strong>
        <%= location %>
    </p>
    <p><strong>Salary:</strong>
        <%= salaryRange %>
    </p>
</div>
<a href="<%= jobUrl %>" class="button">Apply Now</a>
<p>Best regards,<br>The Job Finder Team</p>